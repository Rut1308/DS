Bully Algorithm
import java.util.*;

public class Bully{

public static void main(String[] args){

Scanner sc=new Scanner(System.in);

System.out.println("Enter the number of nodes:");

int n=sc.nextInt();

boolean[] active=new boolean[n];

for(int i=0;i<n;i++)

{

 active[i]=true;

 }

 System.out.println("Enter the node that fails between(1 to "+n+"): ");

 int failedNode=sc.nextInt();

 active[failedNode-1]=false;

 

 System.out.println("Enter the node that detects the failed node and starts the election: ");

 int initiator=sc.nextInt();

 

 System.out.println("\n----Election Process Started----");

 int current=initiator;

 

 for(int i=current;i<n;i++){

 if(active[i]){

 System.out.println("Node "+current+ " sends election message to node "+(i+1));

 System.out.println("Node "+(i+1)+ " responds OK to node "+current);

 current=i+1;

 }

 }

 System.out.println("\n----Node "+current+" is the new Leader!----");

 for(int i=0;i<n;i++){

 if(i!=current-1 && active[i]){

 System.out.println("Node "+current+ " sends leader message to node "+(i+1));

 }

 }

 sc.close();

 }

 }


Ring algorithm

import java.util.*;

public class Ring{

public static void main(String[] args){

Scanner sc=new Scanner(System.in);

System.out.println("Enter the number of nodes:");

int n=sc.nextInt();

boolean[] active=new boolean[n];

for(int i=0;i<n;i++){

active[i]=true;

}

System.out.println("Enter the node that fails between (1 to "+n+"):");

int fail=sc.nextInt();

active[fail-1]=false;

System.out.println("Node "+fail+" is failed!");



System.out.println("Enter the ID of node that detects the failed node and starts the election");

int start=sc.nextInt();

List<Integer>list=new ArrayList<>();

int current=start-1;

list.add(start);

System.out.println("\n[Node "+start+"] started the election. Passing the list"+list);

int i=(current+1)%n;

while(i!=current){

if(active[i]){

list.add(i+1);

System.out.println("\n[Node "+(i+1)+"] received list.Adding self and passing the list"+list);

}

i=(i+1)%n;

}

int leader=Collections.max(list);

System.out.println("\n----Election Over. Node "+leader+" is the new Leader!----");

for(int j=0;j<n;j++){

if(active[j]){

System.out.println("\n[Node "+(j+1)+"] Acknowledged to the new leader "+leader);

}

}

sc.close();

}

}
